# Copy to `.env` and fill in. `.env` is git-ignored: never commit real endpoints,
# they embed an access token.
#
# Names follow forge-std's StdChains convention (<ALIAS>_RPC_URL); CI reads the
# same names from GitHub Actions secrets.
# Chainstack: console.chainstack.com -> your node -> Access and credentials -> HTTPS endpoint.
# Leave a line commented out to use forge-std's public default RPC for that chain.

# Ethereum mainnet. Tests fork at pinned historical blocks: needs an ARCHIVE node.
MAINNET_RPC_URL=https://ethereum-mainnet.core.chainstack.com/<YOUR_ACCESS_TOKEN>

# OPTIMISM_RPC_URL=
# ARBITRUM_ONE_RPC_URL=
# BASE_RPC_URL=
# GNOSIS_CHAIN_RPC_URL=

# Arbitrum Nova is not offered by Chainstack; keep your current provider.
# ARBITRUM_NOVA_RPC_URL=

# X Layer: used by the post-deploy test and `CHAIN=xlayer` deployments.
# Defaults to https://rpc.xlayer.tech when unset.
# XLAYER_RPC_URL=

ETHERSCAN_API_KEY=
